{
  "manifest_version": 3,
  "name": "LeetCode Anki",
  "version": "0.1.1",
  "description": "Spaced repetition for LeetCode problems.",
  "browser_specific_settings": {
    "gecko": { "id": "leetcode-anki@delmundo.dev", "strict_min_version": "115.0" }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://leetcode.com/*"],
  "action": { "default_title": "LeetCode Anki", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["scheduler.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
